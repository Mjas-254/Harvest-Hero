{
  "name": "harvest-hero",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=packages/frontend",
    "dev:backend": "npm run dev --workspace=packages/backend",
    "dev:contracts": "npm run dev --workspace=packages/contracts",
    "build:frontend": "npm run build --workspace=packages/frontend",
    "build:backend": "npm run build --workspace=packages/backend",
    "compile:contracts": "npm run compile --workspace=packages/contracts",
    "test:contracts": "npm run test --workspace=packages/contracts",
    "deploy:fuji": "npm run deploy:fuji --workspace=packages/contracts",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
